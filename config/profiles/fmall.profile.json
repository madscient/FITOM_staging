{
  "profile_name": "FMALL (OPM/OPZ/OPL3/OPL4AWM/OPNA/OPNBB/OPLL/OPLLP/OPLLX/VRC7)",
  "_comment": [
    "統合プリセットプロファイル(unified_preset.profile.json)をベースに、",
    "OPM/OPZ/OPL3/OPL4AWM/OPNA/OPNBB/OPLL/OPLLP/OPLLX/VRC7のみを抜き出した構成。",
    "banksはunified.bankset.jsonを他プロファイルと共有参照しており、",
    "hw_banks/sw_banksのbank番号はhwbank.json内部のsw_bank/sw_prog参照と",
    "常に一致する(手動でのコピー・番号合わせは不要)。"
  ],
  "hw_plugins": [
    {
      "name": "FitomEmuIF",
      "dll": "FitomEmuIF.dll",
      "profile": "config/profiles/hw_plugins/fmemuif_fmall.profile.json",
      "auto_devices": true
    },
    {
      "name": "FitomSf2IF",
      "dll": "FitomSf2IF.dll",
      "profile": "config/profiles/hw_plugins/fitom_sf2if_profile.json"
    }
  ],
  "devices": [
    {
      "if": "HW",
      "label": "OPNBB",
      "chip": "OPNBB",
      "plugin": "FitomEmuIF",
      "index" : 0,
      "pan" : 0,
      "stereo_pair" : "L"
    },
    {
      "if": "HW",
      "label": "OPNBB",
      "chip": "OPNBB",
      "plugin": "FitomEmuIF",
      "index" : 1,
      "pan" : 0,
      "stereo_pair" : "R"
    },
    {
      "if": "HW",
      "label": "OPNL3",
      "chip": "OPNL3",
      "plugin": "FitomEmuIF",
      "index" : 0,
      "pan" : 0,
      "stereo_pair" : "L"
    },
    {
      "if": "HW",
      "label": "OPL4",
      "chip": "OPL4",
      "plugin": "FitomEmuIF",
      "index" : 1,
      "pan" : 0,
      "stereo_pair" : "R"
    },
    {
      "if": "HW",
      "label": "OPLLP",
      "chip": "OPLLP",
      "plugin": "FitomEmuIF",
      "index" : 0,
      "pan" : 1,
      "rhythm_mode" : true,
      "stereo_pair" : "L"
    },
    {
      "if": "HW",
      "label": "OPLLP",
      "chip": "OPLLP",
      "plugin": "FitomEmuIF",
      "index" : 1,
      "pan" : 2,
      "rhythm_mode" : true,
      "stereo_pair" : "R"
    },
    {
      "if": "HW",
      "label": "SF2 (FluidSynth)",
      "chip": "SF2",
      "plugin": "FitomSf2IF"
    }
  ],
  "midi_inputs": [
    "__LOCAL__",
    "__LOCAL__"
  ],
  "sf2_channel_windows": [
    { "mpu": 0, "ch": 14, "fluidsynth_chan": 0 },
    { "mpu": 0, "ch": 15, "fluidsynth_chan": 1 }
  ],
  "banks": "unified.bankset.json",
  "bank_overrides": {
    "_comment": "共有バンクセット(unified.bankset.json)のレイヤードバンク0(patch_banks)・ドラムキット0(drum_banks)はgm_layered_skeleton.patchbank.json(空)・未定義のままで無音のため、このプロファイルに必ず存在するOPL4AWM系デバイス向けのバンクで上書きする(2026年7月新設のbank_overrides機構、既存bank/progとの重複可)。",
    "patch_banks": [
      {
        "bank": 0,
        "file": "../../banks/patches/gm_layered_opl4awm.patchbank.json"
      }
    ],
    "drum_banks": [
      {
        "prog": 0,
        "name": "OPL4-AWM GM set",
        "file": "../../banks/drums/opl4awm.drumkit.json"
      }
    ]
  }
}
