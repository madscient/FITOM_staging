{
  "profile_name": "OPMエミュプロファイル (OPM×2/OPZ×2)",
  "hw_plugins": [
    {
      "name": "FitomEmuIF",
      "dll": "FitomEmuIF.dll",
      "profile": "config/profiles/hw_plugins/fmemuif_opm_opz4.profile.json",
      "auto_devices": true
    },
    {
      "name": "FitomSf2IF",
      "dll": "FitomSf2IF.dll",
      "profile": "config/profiles/hw_plugins/fitom_sf2if_profile.json"
    }
  ],
  "devices": [
    {
      "if": "HW",
      "label": "SF2 (FluidSynth)",
      "chip": "SF2",
      "plugin": "FitomSf2IF"
    }
  ],
  "midi_inputs": [
    "__LOCAL__",
    "__LOCAL__"
  ],
  "sf2_channel_windows": [
    { "mpu": 0, "ch": 14, "fluidsynth_chan": 0 },
    { "mpu": 0, "ch": 15, "fluidsynth_chan": 1 }
  ],
  "banks": "unified.bankset.json",
  "bank_overrides": {
    "_comment": "共有バンクセット(unified.bankset.json)のレイヤードバンク0(patch_banks)・ドラムキット0(drum_banks)はgm_layered_skeleton.patchbank.json(空)・未定義のままで無音のため、このプロファイルに必ず存在するOPM系デバイス向けのバンクで上書きする(2026年7月新設のbank_overrides機構、既存bank/progとの重複可)。ドラムキットについては、OPM/OPZ固有のchip依存drumkitがunified.bankset.json側に存在しないため、レイヤードバンク0(このオーバーライドで有効化したgm_layered_opm.patchbank.json)経由で発音するgm2_standard.drumkit.jsonを割り当てる。",
    "patch_banks": [
      {
        "bank": 0,
        "file": "../../banks/patches/gm_layered_opm.patchbank.json"
      }
    ],
    "drum_banks": [
      {
        "prog": 0,
        "name": "GM2 Standard Kit",
        "file": "../../banks/drums/gm2_standard.drumkit.json"
      }
    ]
  }
}
