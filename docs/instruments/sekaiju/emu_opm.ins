; ----------------------------------------------------------------------

.Controller Names

[emu_opm Controllers]
0=Bank Select MSB
1=Modulation Depth
5=Portamento Time
6=Data Entry MSB
7=Channel Volume
10=Pan
11=Expression
32=Bank Select LSB
38=Data Entry LSB
64=Hold1
65=Portamento On/Off
66=Sostenuto
67=Soft
91=Reverb Send Level
93=Chorus Send Level
100=RPN LSB
101=RPN MSB
120=All Sound Off
121=Reset All Controller
123=All Note Off

; ----------------------------------------------------------------------

.RPN Names

[emu_opm RPN]
0=Pitch Bend Sensitivity
1=Channel Fine Tune
2=Channel Coarse Tune

